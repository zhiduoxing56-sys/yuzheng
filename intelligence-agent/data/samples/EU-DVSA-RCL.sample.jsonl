{"record_id": "EU-DVSA-AUDI-Q5-2016-bdd26f83", "source_id": "EU-DVSA-RCL", "region": "EU", "language": "EN", "source_type": "RECALL", "title": "召回: How the manufacturer will repair", "raw_text": "How the manufacturer will repair Recall the vehicles that are likely to be affected to check for water seepage and the drainage is correct from the panoramic sunroof area. Check the pressure cylinders for corrosion treat with anti-corrosion wax or replace as necessary. Remove foam which is next to the pressure cylinder.", "published_at": "", "retrieved_at": "2026-08-14T20:13:37.372052+00:00", "manufacturer": "AUDI", "brand": "AUDI", "model": "Q5", "year": 2016, "component_raw": "", "failure_description": "Recall the vehicles that are likely to be affected to check for water seepage and the drainage is correct from the panoramic sunroof area. Check the pressure cylinders for corrosion treat with anti-corrosion wax or replace as necessary. Remove foam which is next to the pressure cylinder.", "consequence_raw": "", "source_url": "https://www.check-vehicle-recalls.service.gov.uk/recall-type/vehicle/make/AUDI/model/Q5/year/2016/recalls", "official_confirmed": true, "content_hash": "61a60a7d7ca873050efba1c071295a0d", "parser_version": "v3.0-eu"}
